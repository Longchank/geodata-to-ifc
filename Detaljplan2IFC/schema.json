{
  "_comment": "Shared schema for the Detaljplan2IFC pipeline (lm_detaljplan_to_cityjson.py + lm_cityjson_to_ifc.py). Edit this file to change CityJSON/IFC class mapping, Pset property names/types, or per-type color/alpha - no code changes needed. See README for full documentation.",

  "feature_types": {
    "detaljplan": {
