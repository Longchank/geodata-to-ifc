    },
    "administrativ bestämmelse": {
      "cityjson_type": "GenericCityObject",
      "ifc_class": "IfcCivilElement",
      "color": { "rgb": [0.9, 0.6, 0.1], "alpha": 0.5 }
    },
    "egenskapsbestämmelse": {
      "cityjson_type": "GenericCityObject",
      "ifc_class": "IfcCivilElement",
      "color": { "rgb": [0.2, 0.4, 0.9], "alpha": 0.5 }
    }
  },

